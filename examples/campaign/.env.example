# Campaign settings for `bulk-email`. Copy to `<campaign-dir>/.env` and fill in,
# or keep one shared file elsewhere and pass `--env-file <path>`.
# Process env always wins over this file.

# --- SMTP transport (same names as @marianmeres/send-email) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for implicit TLS (port 465); defaults to (port === 465) when unset.
SMTP_SECURE=false
SMTP_USER=user@example.com
# NEVER pass credentials via CLI flags — env only. Keep this file out of git.
SMTP_PASS=secret

# --- Message ---
# Sender (required to send). "Name <addr>" form is fine.
SMTP_FROM=Your Name <you@example.com>
# Optional Reply-To.
SMTP_REPLY_TO=
# Optional BCC on every message — e.g. yourself, to keep a copy.
BCC=
# Unique References / X-Entity-Ref-ID headers on every message, so Gmail does not
# group same-subject messages from you into one conversation. Default true; set
# false only if you want sends to thread.
PREVENT_THREADING=true

# --- Pacing & retries (optional) ---
# Base pause between two sends in ms, ± 20 % jitter. Default 10000.
DELAY_MS=10000
# Failed attempts before a recipient is given up on. Default 3.
MAX_ATTEMPTS=3

# --- TLS escape hatches / timeouts (optional, see send-email) ---
# SMTP_SERVERNAME=
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=10000

{
	"name": "@marianmeres/bulk-email",
	"version": "0.5.0",
	"exports": "./src/main.ts",
	"tasks": {
		"test": "deno test -A",
		"test:watch": "deno test -A --watch",
		"check": "deno check src/*.ts tests/*.ts scripts/*.ts",
		"lint": "deno lint",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno task preflight && deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish",
		"preflight": "deno run --allow-read=deno.json scripts/preflight-publish.ts"
	},
	"imports": {
		"@marianmeres/cli-status-line": "jsr:@marianmeres/cli-status-line@^0.2.0",
		"@marianmeres/interpolate": "jsr:@marianmeres/interpolate@^1.3.0",
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
		"@marianmeres/parse-boolean": "jsr:@marianmeres/parse-boolean@^2.1.0",
		"@marianmeres/parse-csv": "jsr:@marianmeres/parse-csv@^1.3.0",
		"@marianmeres/send-email": "jsr:@marianmeres/send-email@^1.1.0",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/cli": "jsr:@std/cli@^1.0.32",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.8",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/path": "jsr:@std/path@^1.1.6"
	},
	"minimumDependencyAge": {
		"exclude": [
			"jsr:@marianmeres/*",
			"npm:@marianmeres/*"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	},
	"publish": {
		"exclude": [
			".*",
			"tests/**",
			"docs/**",
			"scripts/**",
			"tmp/**"
		]
	}
}
